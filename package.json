{
  "name": "pumper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx tests/e2e.ts",
    "setup:browser": "playwright install chromium",
    "format": "prettier --write src server scripts tests *.json *.ts *.html README.md",
    "format:check": "prettier --check src server scripts tests *.json *.ts *.html README.md",
    "setup:foreground": "tsx scripts/setup-foreground.ts",
    "test:e2e:foreground": "PUMPER_TEST_FOREGROUND=1 tsx tests/e2e.ts",
    "test:foreground-renderer": "tsx tests/foreground-renderer.e2e.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "express": "^5.1.0",
    "fflate": "^0.8.2",
    "ffmpeg-static": "^5.2.0",
    "multer": "^2.0.2",
    "onnxruntime-node": "^1.30.0",
    "playwright": "^1.55.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.4",
    "tsx": "^4.20.5",
    "vite": "^7.1.5",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2"
  }
}
